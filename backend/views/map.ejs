<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Tricity Property Map | Tricity Property Intelligence</title>

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
    <link rel="stylesheet" href="/map.css">
</head>

<body>

    <div class="map-page">

        <header class="map-header">
            <div class="brand">
                <div class="brand-icon">T</div>
                <div>
                    <h2>Tricity Intelligence</h2>
                    <p>Property Explorer</p>
                </div>
            </div>

            <a href="/" class="back-btn">← Back to Home</a>
        </header>

        <div class="map-heading">
            <div>
                <span class="eyebrow">EXPLORE THE TRICITY REGION</span>
                <h1>Discover Properties Across Tricity</h1>
                <p>Explore localities across Chandigarh, Mohali and Panchkula.</p>
            </div>

            <div class="map-status">
                <span class="status-dot"></span>
                Interactive Map
            </div>
        </div>

        <main class="map-container">

            <div class="map-toolbar">
                <div>
                    <strong>Tricity Property Map</strong>
                    <p>Explore available locality markers</p>
                </div>

                <span class="map-label">OPEN STREET MAP</span>
            </div>

            <div id="map"></div>

        </main>


        <footer class="map-footer">
            <span>Tricity Property Intelligence</span>
            <span>Powered by Leaflet & OpenStreetMap</span>
        </footer>

    </div>


    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="/map.js"></script>

</body>

</html>